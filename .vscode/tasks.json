{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Watch RaylibSharpGenerator",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "--project",
                "${workspaceFolder}/RaylibSharpGenerator/RaylibSharpGenerator.csproj"
            ],
            "options": {
                "cwd": "${workspaceFolder}/RaylibSharpGenerator/"
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": []
        }
    ]
}
